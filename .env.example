# Live agent (LOCAL ONLY). Never set MODEL_API_KEY on a hosted service.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_DEFAULT=muse-spark-1.3
MODEL_ESCALATE=muse-wonder-1.0
# [VERIFY with scripts/probe-api.ts] request-shape knobs for reasoning models
MODEL_MAX_TOKENS_PARAM=max_tokens
MODEL_REASONING_EFFORT=low
# Hard dollar caps enforced in code (lib/agent/budget.ts)
RUN_BUDGET_USD=1.5
DEV_BUDGET_USD=60
# Sequential, resumable 20-scenario evaluation batch cap (includes earlier attempts)
EVAL_BUDGET_USD=3
# BLINDSPOT_SESSIONS_DIR=.data/live

# Auth + database (local). Leave DATABASE_URL unset to use embedded Postgres in .data/pglite.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
# ORG_BUDGET_USD=20

# Optional localhost demo-login buttons; npm run demo:setup creates random credentials.
# BLINDSPOT_DEMO_LOGIN=true
# BLINDSPOT_DEMO_PASSWORD=generated-by-demo-setup
